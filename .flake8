[flake8]
exclude =
    .git,
    __pycache__,
    build,
    dist,
    # the virtual environment
    env,
extend-ignore =
    # E266 too many leading '#' for block comment (the license header)
    E266,
    # E203 whitespace before ':' (black puts it in slices)
    E203,
per-file-ignores =
    # unused imports in __init__
    swindl/__init__.py:F401
    swindl/*/__init__.py:F401,F403
max-line-length = 88
